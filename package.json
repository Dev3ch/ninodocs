{
  "name": "ninodocs",
  "version": "1.0.4",
  "description": "Beautiful, embeddable API documentation library. Drop-in interactive docs via CDN or npm — no Node required on the consumer side.",
  "type": "module",
  "license": "MIT",
  "author": "Enrique Chavez <developer@dev3ch.com>",
  "keywords": [
    "documentation",
    "docs",
    "api-docs",
    "markdown",
    "interactive-docs",
    "openapi",
    "preact",
    "cdn"
  ],
  "packageManager": "yarn@4.14.1",
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/ninodocs.umd.cjs",
  "module": "./dist/ninodocs.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/ninodocs.js",
      "require": "./dist/ninodocs.umd.cjs"
    },
    "./style.css": "./dist/ninodocs.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@preact/signals": "^2.0.1",
    "markdown-it": "^14.1.0",
    "preact": "^10.27.0",
    "shiki": "^1.29.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@preact/preset-vite": "^2.10.2",
    "@tailwindcss/vite": "^4.0.0",
    "@types/babel__core": "^7",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.21.0",
    "@typescript-eslint/parser": "^8.21.0",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vite-plugin-dts": "^4.5.0"
  }
}
